{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/service/",
      "destination": "/verkaufen/",
      "permanent": true
    },
    {
      "source": "/service",
      "destination": "/verkaufen/",
      "permanent": true
    },
    {
      "source": "/service/index.html",
      "destination": "/verkaufen/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/immobilie/:slug/",
      "destination": "/api/property-page?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/immobilien-test/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/immobilien/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/immobilie/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/propstack-contact-request.js": {
      "maxDuration": 60
    },
    "api/property-page.js": {
      "includeFiles": "immobilien/index.html",
      "maxDuration": 60
    },
    "api/propstack-guide-request.js": {
      "maxDuration": 60
    },
    "api/sia-ask.js": {
      "maxDuration": 60
    },
    "api/profile-reviews.js": {
      "maxDuration": 60
    },
    "api/career-application.js": {
      "maxDuration": 60,
      "regions": [
        "fra1"
      ]
    },
    "api/buyer-demand.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "node scripts/build-magazine.mjs"
}
